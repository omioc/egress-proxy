# =============================================================================
# egress-proxy tcp-forwarder 镜像
#
# 构建（在 egress-proxy 目录下执行）：
#   docker build -f Dockerfile.proxy -t <registry>/egress-proxy/tcp-forwarder:0.1.0 .
# 或（Windows / PowerShell 7，构建并导出 tar 到 deploy/）：
#   pwsh ./scripts/build-images.ps1 -Tag 0.1.0
# =============================================================================

# ---------- 构建阶段 ----------
FROM golang:1.24-alpine AS build

# Go 模块代理：默认走 goproxy.cn（国内网络更稳定），可用 --build-arg GOPROXY=... 覆盖
ARG GOPROXY=https://goproxy.cn,direct
ARG VERSION=dev
ENV GOPROXY=${GOPROXY}

WORKDIR /src

# 依赖按 go.sum 通过 GOPROXY 拉取（仓库不含 vendor/）；先只拷清单，这一层可命中构建缓存
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# 静态编译，产物放 /out
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X egress-proxy/internal/logging.Version=${VERSION}" -o /out/tcp-forwarder ./cmd/tcp-forwarder

# ---------- 运行阶段 ----------
FROM alpine:3.20

# 转发服务不需要 iptables / 特权，只需要根证书用于（可选的）TLS 透传场景与健康检查
RUN apk add --no-cache ca-certificates

COPY --from=build /out/tcp-forwarder /usr/local/bin/tcp-forwarder

ENTRYPOINT ["/usr/local/bin/tcp-forwarder"]
